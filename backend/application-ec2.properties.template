# EC2-specific overrides
# On first deploy, this is copied to ~/backend-app/application-ec2.properties
# Edit that file with your real AWS credentials, then restart the backend.

# AWS S3
aws.s3.bucket=your-bucket-name
aws.s3.region=us-east-1
aws.access-key-id=YOUR_ACCESS_KEY_ID
aws.secret-access-key=YOUR_SECRET_ACCESS_KEY
